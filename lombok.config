# Lombok — el monolito resuelve varias ambiguedades con @Qualifier en campos.
# Sin esta linea, @RequiredArgsConstructor no copia @Qualifier al parametro del
# constructor y Spring no puede desambiguar (p.ej. IProductSyncCommandPort).
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
